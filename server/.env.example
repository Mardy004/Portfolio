# ---- Server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins. `*` wildcards are supported
# for preview deployments, e.g.:
#   CLIENT_ORIGIN=https://portfolio.vercel.app,https://*.vercel.app
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ---- Local storage locations (optional) ----
# Defaults: server/data (JSON store) + server/uploads (images).
# On hosts with an ephemeral filesystem, point these at a persistent disk:
#   DATA_DIR=/var/data
#   UPLOAD_DIR=/var/data/uploads
# When the filesystem is read-only (Vercel Functions) the server automatically
# falls back to a temp directory, which is wiped when the instance recycles —
# so use Firestore (FIREBASE_SERVICE_ACCOUNT) there.

# ---- Uploads ----
# Max image size in MB. 4 MB is the safe default for Vercel (4.5 MB request cap).
UPLOAD_MAX_MB=4

# ---- Default admin (seeded on first boot) ----
ADMIN_USERNAME=mariette250
ADMIN_PASSWORD=PortoMariettte2026

# ---- Firebase WEB config (reference) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Firebase ADMIN service account ----
# Paste the service-account JSON on a single line to persist to Firestore.
# Leave empty to use the zero-config local JSON store (server/data/db.json).
# On a host (Render / Railway / Fly) paste the whole JSON here — the secret key
# file is never committed.
FIREBASE_SERVICE_ACCOUNT=
# Or point at a mounted key file instead:
# FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json

# Force the local store even if a service account is present:
USE_LOCAL_STORE=

# ---- Nodemailer (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_TO=