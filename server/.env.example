# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ---- Default admin (seeded on first boot) ----
ADMIN_USERNAME=mariette250
ADMIN_PASSWORD=PortoMariettte2026

# ---- Firebase WEB config (reference) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Firebase ADMIN service account ----
# Paste the service-account JSON on a single line to persist to Firestore.
# Leave empty to use the zero-config local JSON store (server/data/db.json).
FIREBASE_SERVICE_ACCOUNT=

# Force the local store even if a service account is present:
USE_LOCAL_STORE=

# ---- Nodemailer (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_TO=