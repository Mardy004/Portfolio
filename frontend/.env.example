# The frontend talks to the backend through Vite's dev proxy, so in
# development you normally do NOT need to set anything here.
#
# For deployments where the API lives on a different origin (e.g. the frontend
# on Vercel + the Express API on Render) set the deployed API origin, WITHOUT a
# trailing slash and WITHOUT /api:
#
#   VITE_API_URL=https://mariette-portfolio-api.onrender.com
#
# Vite inlines this value at BUILD time, so set it in the Vercel project
# (Settings → Environment Variables) and redeploy for it to take effect.
VITE_API_URL=